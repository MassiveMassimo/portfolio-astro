---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Page Not Found">
  <div
    class="flex min-h-screen flex-col items-center justify-center p-4 text-center"
  >
    <h1 class="mb-4 text-6xl font-bold text-gray-900">404</h1>
    <p class="mb-8 text-xl text-gray-600">Page not found</p>
    <a
      href="/"
      class="rounded-lg bg-gray-900 px-6 py-3 text-white transition hover:bg-gray-700"
    >
      Go back home
    </a>
  </div>
</Layout>

