---

---

<div
  id="container"
  class="relative flex min-h-screen flex-col font-sans text-gray-900 md:block"
>
  <img
    id="background"
    src="/background.svg"
    alt=""
    fetchpriority="high"
    class="fixed inset-0 -z-10 h-full w-full blur-[100px]"
  />
  <main class="flex min-h-screen justify-center">
    <section
      id="hero"
      class="flex flex-col items-start justify-center p-4 pt-[10%] md:pt-0"
    >
      <a href="https://astro.build"
        ><img
          src="/astro.svg"
          width={115}
          height={48}
          alt="Astro Homepage"
        /></a
      >
      <h1 class="text-foreground mt-1 text-[22px] leading-snug">
        To get started, open the
        <code
          class="inline-block rounded-lg border border-transparent bg-[linear-gradient(66.77deg,#f3cddd_0%,#f5cee7_100%)] bg-clip-padding px-2 py-1 align-middle"
        >
          <pre
            class="m-0 bg-linear-to-tr from-[#d83333] to-[#f041ff] bg-clip-text font-mono font-normal text-transparent">src/pages</pre>
        </code>
        directory in your project.
      </h1>
      <section id="links" class="mt-4 flex flex-wrap gap-4 md:flex-nowrap">
        <a
          class="text-foreground hover:text-muted-foreground flex items-center rounded-lg bg-linear-to-r from-[#3245ff] to-[#bc52ee] px-3 py-2 no-underline shadow-[inset_0_0_0_1px_rgba(255,255,255,0.12),inset_0_-2px_0_rgba(0,0,0,0.24)] transition-colors duration-200 hover:shadow-none"
          href="https://docs.astro.build">Read our docs</a
        >
        <a
          class="flex items-center rounded-lg px-3 py-2 text-gray-900 no-underline transition-colors duration-200 hover:text-gray-600"
          href="https://astro.build/chat"
          >Join our Discord
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 127.14 96.36"
            class="ml-2 h-4 w-4"
            ><path
              fill="currentColor"
              d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15ZM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69Zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69Z"
            ></path></svg
          >
        </a>
      </section>
    </section>
  </main>

  <a
    href="https://astro.build/blog/astro-5/"
    id="news"
    class="absolute right-4 bottom-10 left-4 max-w-full rounded-2xl border border-white bg-white p-4 text-gray-900 no-underline backdrop-blur-[50px] transition-[background] duration-200 hover:bg-white/60 md:right-4 md:bottom-4 md:left-auto md:max-w-[300px]"
  >
    <svg width="32" height="32" fill="none" xmlns="http://www.w3.org/2000/svg"
      ><path
        d="M24.667 12c1.333 1.414 2 3.192 2 5.334 0 4.62-4.934 5.7-7.334 12C18.444 28.567 18 27.456 18 26c0-4.642 6.667-7.053 6.667-14Zm-5.334-5.333c1.6 1.65 2.4 3.43 2.4 5.333 0 6.602-8.06 7.59-6.4 17.334C13.111 27.787 12 25.564 12 22.666c0-4.434 7.333-8 7.333-16Zm-6-5.333C15.111 3.555 16 5.556 16 7.333c0 8.333-11.333 10.962-5.333 22-3.488-.774-6-4-6-8 0-8.667 8.666-10 8.666-20Z"
        fill="#111827"></path></svg
    >
    <h2 class="mb-4 text-[20px] font-normal text-gray-900">
      What's New in Astro 5.0?
    </h2>
    <p class="text-base leading-6 tracking-tight text-gray-600">
      From content layers to server islands, click to learn more about the new
      features and improvements in Astro 5.0
    </p>
  </a>
</div>
